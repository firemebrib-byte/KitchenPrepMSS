# 服务监听端口：单机本地部署时如遇 3000 端口被其他程序占用导致启动失败，
# 修改此项为其他未被占用的端口号（如 8080）后重新启动即可，无需改动任何代码
PORT="3000"

# 首页登录密码
VITE_LOGIN_PASSWORD="guest"

# 管理后台密码
VITE_ADMIN_PASSWORD="admin"

# === 数据持久化存储配置 ===
# 存储模式: local（本地单机模式，默认） 或 cos（腾讯云对象存储模式）
STORAGE_TYPE="local"

# 1. 本地单机部署模式配置
# 本地数据存储目录：SQLite 数据库文件（kpmss.sqlite）位于此目录下
LOCAL_DATA_DIR="data"

# === 自动备份配置（仅 local 模式）===
# 快照存放于 LOCAL_DATA_DIR/backups/。进程启动即备一份，之后按下方间隔定时备份；
# 「一键清空台账流水 / 删除台账 / 删除人群」这类不可逆操作在执行前也会各自强制先备一份（备份失败则该操作中止）。
# 定时备份间隔（小时），默认 24；最小 1
KPMSS_BACKUP_INTERVAL_HOURS="24"
# 滚动保留的快照份数（超出后自动删除最旧的），默认 30；最小 1
KPMSS_BACKUP_KEEP="30"
# 设为 1 可完全关闭"启动时 + 定时"的自动备份（删除前的强制备份不受此开关影响）
KPMSS_DISABLE_AUTO_BACKUP="0"

# 2. 腾讯云 COS 对象存储部署模式配置（当 STORAGE_TYPE 为 cos 时必填）
COS_SECRET_ID="YOUR_TENCENT_COS_SECRET_ID"
COS_SECRET_KEY="YOUR_TENCENT_COS_SECRET_KEY"
COS_REGION="ap-guangzhou"
COS_BUCKET="kitchen-prep-1234567890"
COS_KEY="kitchen_db.json"

# === 本地日志归档配置 ===
# 日志根目录：每天的运行日志各自独立成文件存放于此目录下（如 app-2026-07-03.log）
LOCAL_LOG_DIR="data/logs"

# 单个日志文件的体积上限（单位 MB）：超出后自动滚动到下一个序号分片文件（如 app-2026-07-03.1.log）继续写入
LOG_MAX_FILE_SIZE_MB="5"

# 低层 SQL 逐句追踪：设为 1 后，SQLite 每执行一条 SQL（含 BEGIN/COMMIT/ROLLBACK 及每条 SELECT/INSERT/UPDATE/DELETE）
# 都会把语句原文写进数据审计日志 audit-*.log。默认关闭——它连每次页面加载的多条 SELECT 都会打出来、量很大，
# 只在排查"数据库层面到底发生了什么"时临时开启，排查完记得改回 0（或删掉此行）。
# 注意：写操作的“逐条 prepared statement + 实际影响行数(changes)”始终会记录，不受此开关影响。
KPMSS_SQL_TRACE="0"

